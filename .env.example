#                                         /____/              
# ==============================================================================
#  One manager to rule them all. Local-first, Encrypted, Powerful.
# ==============================================================================

# ==============================================================================
#                          ESSENTIAL SETUP
# ==============================================================================

# --- Server Port ---
# The port the application listens on inside the container.
# If running via Docker Compose, this maps to the host port defined there (default 1610).
PORT=1610

# --- Environment Mode ---
# 'production' = Fast performance, minimal logging.
# 'development' = Verbose logging, hot-reloading (if applicable).
# Default: production
NODE_ENV=production

# ==============================================================================
#                          DATABASE CONFIGURATION
# ==============================================================================

# --- Database Engine ---
# Options: sqlite, postgres
# Default: sqlite
DB_TYPE=sqlite

# --- Database URL (PostgreSQL ONLY) ---
# Format: postgres://user:password@host:port/database
# DOCKER EXAMPLE: postgres://aio_user:aio_password@aiomanager-db:5432/aio_manager
# LOCAL EXAMPLE: postgres://postgres:password@localhost:5432/aio_db
# Leave empty if using SQLite
DATABASE_URL=

# --- PostgreSQL SSL Verification ---
# Disabled by default for compatibility, as many PostgreSQL providers use
# self-signed certificates. Set to true only for providers/self-hosted
# databases with a pinned, trusted private network path.
DB_SSL_REJECT_UNAUTHORIZED=false

# --- Read-Only Replica (Geo-Redundancy, PostgreSQL ONLY) ---
# Run this instance as a standby pointed at a read-only Postgres replica
# (e.g. via streaming replication from a primary in another region). When set:
#   - Schema creation and migrations are skipped (the follower DB is read-only).
#   - The autopilot and activity workers are NOT started, so the standby runs no
#     background writes and never acts as a second controller against your accounts.
#     (Request-driven writes, e.g. editing addons, are still attempted and fail
#     cleanly against the read-only DB until the replica is promoted.)
# REQUIRED: set ENCRYPTION_KEY on the standby to the SAME value as the primary
# (or copy the primary's data/server_secret.key into the standby's DATA_DIR).
# Replicated rows are encrypted with the primary's key; with a different key the
# standby boots fine but decrypts nothing and serves empty configs/addons. If you
# leave ENCRYPTION_KEY blank on a replica, the server logs a loud warning at boot.
#
# While the primary is unavailable, the standby keeps serving existing configs
# read-only (addon proxy, manifests, catalogs, streams), so nothing goes dark.
# Load-balancer probes if you front both regions:
#   - GET /api/health stays HTTP 200 on a standby (mode:"read-only-replica",
#     readOnly:true) so it remains reachable for read traffic.
#   - GET /api/ready returns HTTP 503 on a standby (200 on the primary). Point your
#     write-routing health check at it to keep the standby out of write traffic.
# Two ways it resolves:
#   - Transient outage: the primary comes back and resumes. No action needed.
#   - Full takeover: promote the replica to a writable primary (pg_promote) and
#     restart this instance with READ_ONLY_REPLICA unset. It then becomes the
#     active primary, autopilot and writes included.
# Leave false on your primary.
# Default: false
READ_ONLY_REPLICA=false

# --- Data Directory ---
# The absolute path where AIOManager stores its SQLite database (aio.db).
# IN DOCKER: This MUST match the volume mount path (e.g., /app/data).
DATA_DIR=/app/data

# --- Database Filename ---
# The name of the SQLite database file.
# Default: aio.db
DB_FILENAME=aio.db

# ==============================================================================
#                          SECURITY & SYNC LIMITS
# ==============================================================================

# --- Sync API Limit ---
# Maximum size of the encrypted state blob allowed for sync (in bytes).
# Default: 104857600 (100 MB) allows for extremely large configurations.
MAX_SYNC_PAYLOAD_SIZE=104857600

# --- Server Encryption Key ---
# Used to encrypt sensitive data (like Autopilot auth keys) at rest.
# ZERO-CONFIG: If left empty, the server automatically generates a secure key
# and saves it to DATA_DIR/server_secret.key on first run.
# FALLBACK: If you set a manual key later, the server will keep the auto-generated
# one as a fallback to ensure existing user data remains readable.
ENCRYPTION_KEY=

# --- Allowed Origins (CORS) ---
# Comma-separated list of allowed origins for the API.
# Leave empty to allow all (useful for local networks).
# Example: https://myapp.com,https://localhost:1610
CORS_ORIGINS=*

# --- Custom HTML Injection ---
# Display custom HTML at the top of the login/configuration page (useful for hosted banners).
# Example: CUSTOM_HTML="<div style='background: #ff0000; color: white; padding: 10px; border-radius: 8px; margin-bottom: 20px;'>Announcement: Maintenance scheduled for tonight.</div>"
CUSTOM_HTML=

# --- Registrations Closed ---
# Block new account creation while letting existing users sign in.
# Default: false
REGISTRATIONS_CLOSED=false

# ==============================================================================
#                               LOGGING
# ==============================================================================

# --- Log Level ---
# Control the verbosity of server logs.
# Options: fatal, error, warn, info, debug, trace
# Default: info
LOG_LEVEL=info

# --- Pretty Print ---
# Format logs for human readability (true) or JSON for machine parsing (false).
# Recommended: false for production (faster), true for debugging.
LOG_PRETTY_PRINT=true

# ==============================================================================
#                          ACTIVITY ENGINE (OPT-IN)
# ==============================================================================

# Server-side background polling that captures watch activity (events + snapshots)
# into the database on a timer, so Activity/Replay history keeps building even when
# no client is open. Disabled by default: on a multi-tenant or public instance every
# account is polled each cycle, the write-amplification pattern behind the Midnight
# incident. Client-side Activity tracking works without this, so enable it only on a
# single-user or trusted self-hosted instance where you want server-captured history
# that persists without the app running.
#
# Scope: the scanner reads STREMIO credentials only. Non-Stremio connections
# (Nuvio/RealStream/Hydra) are tracked client-side via the library cache, not here, so
# a one-time "only Stremio credentials are scanned" log notice is expected and benign
# when such accounts exist. See _architecture/decisions.md "Activity Engine".
ACTIVITY_ENGINE_ENABLED=false

# Safe defaults if you explicitly opt into server-side Activity capture.
ACTIVITY_SCAN_INTERVAL_MS=300000
ACTIVITY_SCAN_JITTER_MS=120000
ACTIVITY_INITIAL_DELAY_MS=30000
ACTIVITY_CYCLE_BUDGET_MS=120000
ACTIVITY_MAX_ACCOUNTS_PER_CYCLE=50
ACTIVITY_MAX_EVENTS_PER_CYCLE=1000
ACTIVITY_MAX_SNAPSHOT_WRITES_PER_CYCLE=5000
ACTIVITY_BATCH_SIZE=40
ACTIVITY_FETCH_TIMEOUT_MS=10000
ACTIVITY_HASH_CACHE_TTL_MS=86400000
ACTIVITY_HASH_CACHE_MAX=5000
# Activity events are kept permanently so Activity can behave like Replay.

# --- Mock Data (Development Only) ---
# Generate mock activity data for metrics development
# VITE_MOCK_ACTIVITY=false

# --- Autopilot Engine ---
# Maximum rules processed per scan cycle
# AUTOPILOT_SCAN_CHUNK_SIZE=500
# Maximum budget per autopilot scan cycle in milliseconds
# AUTOPILOT_CYCLE_BUDGET_MS=120000

# ==============================================================================
#                       ADVANCED SERVER TUNING
# ==============================================================================
# These values are pre-set to sensible defaults. Override only if you know what
# you are doing. Uncommented = active with the shown default.

# --- Proxy & Throttling ---
# Maximum concurrent outbound proxy/metadata requests the server will fan out.
# Default: 50
PROXY_CONCURRENCY_LIMIT=50
# Minimum interval (ms) between calls to a single AIOStreams user API endpoint.
# Default: 1000
AIOSTREAMS_USER_API_THROTTLE_MS=1000
# Per-request timeout (ms) for the poster/image proxy. Lower = fail fast when an
# image source is slow, so the shared proxy queue drains instead of clogging.
# Default: 4000
IMAGE_PROXY_TIMEOUT_MS=4000
# Max concurrent in-flight image-proxy requests. Isolates poster storms from the
# stream/manifest proxies that share the global queue. Default: 150
IMAGE_PROXY_QUEUE_LIMIT=150
# Minimum interval (ms) between image-proxy calls to a single host. MetaHub is a
# CDN, so this is much lower than the global throttle to avoid serializing a page
# of posters behind one origin. Default: 25
IMAGE_PROXY_THROTTLE_MS=25
# Shared in-memory poster cache (helps public/multi-user instances: hot posters
# serve from memory, identical cold requests collapse into one upstream fetch).
# Bounded by total bytes, not entry count. Set MAX_BYTES=0 to disable the cache.
IMAGE_CACHE_TTL_MS=86400000
IMAGE_CACHE_MAX_BYTES=134217728
IMAGE_CACHE_MAX_ITEM_BYTES=524288
# Unify certain server-side enforcement checks across modules. Leave disabled for
# the default per-module behavior.
# UNIFIED_ENFORCEMENT=false

# --- PostgreSQL Pool Tuning (ignored when DB_TYPE=sqlite) ---
# Maximum number of connections in the PostgreSQL pool.
# Default: 20
DB_POOL_SIZE=20
# Milliseconds to wait for a connection before timing out.
# Default: 10000
DB_CONNECTION_TIMEOUT=10000
# Number of connection attempts on startup (exponential backoff).
# Default: 5
DB_MAX_RETRIES=5

# --- Autopilot Engine Tuning ---
# Hard cap on rules processed in a single autopilot cycle.
# Default: 5000
AUTOPILOT_MAX_RULES_PER_CYCLE=5000
# How long addon health check results are cached (ms).
# Default: 30000
AUTOPILOT_HEALTH_CACHE_TTL_MS=30000
# Minimum interval (ms) before a rule is re-evaluated.
# Default: 30000
AUTOPILOT_RULE_RECHECK_MS=30000
# Byte budget for caching rules' stable columns (addon_list/priority_chain) in
# memory so the worker stops re-reading them from the DB every cycle. Big win on
# remote databases (e.g. Supabase). Set to 0 to disable the cache. Default: 256MB
AUTOPILOT_RULE_CACHE_MAX_BYTES=268435456
# Safety-net TTL (ms) for the rule cache. Invalidation is normally event-driven
# (a write bumps updated_at); this just caps how long a stale entry could survive
# if a future write path forgets to bump it. Default: 600000 (10 min)
AUTOPILOT_RULE_CACHE_TTL_MS=600000

